<?xml version="1.0" encoding="utf-8"?>
<!--
  Profil de publication ClickOnce du client KyWigRemote.
  Produit un fichier « KyWigRemote.Client.application » (manifeste de déploiement) + les
  fichiers d'application. Autonome (runtime .NET embarqué) : rien à installer sur le poste cible.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>dist\ClientClickOnce\</PublishDir>
    <PublishUrl>dist\ClientClickOnce\</PublishUrl>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>False</PublishSingleFile>
    <PublishReadyToRun>False</PublishReadyToRun>
    <BootstrapperEnabled>False</BootstrapperEnabled>
    <GenerateManifests>true</GenerateManifests>
    <Install>true</Install>
    <UpdateEnabled>false</UpdateEnabled>
    <ProductName>KyWigRemote</ProductName>
    <PublisherName>KyWig Informatique</PublisherName>
    <ApplicationVersion>1.0.0.*</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <CreateWebPageOnPublish>false</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
  </PropertyGroup>
</Project>
