{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "KyWigRemote": {
    "Server": {
      "Urls": "http://localhost:5080"
    },
    "Database": {
      "Provider": "Sqlite",
      "SqlitePath": "%LOCALAPPDATA%\\KyWigRemote\\kywigremote.db",
      "SqlServerConnectionString": ""
    },
    "Authentication": {
      "Providers": [ "Local" ],
      "ActiveDirectory": {
        "Domain": "kywig.ad",
        "UserGroup": "GG_KyWigRemote_Users",
        "AdminGroup": "GG_KyWigRemote_Admins"
      },
      "Microsoft365": {
        "Instance": "https://login.microsoftonline.com/",
        "TenantId": "",
        "ClientId": ""
      },
      "Local": {
        "Enabled": true
      },
      "Jwt": {
        "Issuer": "KyWigRemote",
        "Audience": "KyWigRemote",
        "LifetimeMinutes": 480,
        "SigningKey": ""
      }
    }
  }
}
