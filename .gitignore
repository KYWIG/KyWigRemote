# === Sorties de compilation .NET ===
bin/
obj/
dist/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.dll
*.exe
*.pdb

# Exception : interop ActiveX RDP généré par AxImp, committé pour un build reproductible
# sans l'outillage Visual Studio (voir KyWigRemote.Client/KyWigRemote.Client.csproj).
!src/KyWigRemote.Client/lib/
!src/KyWigRemote.Client/lib/*.dll

# === Fichiers utilisateur / IDE ===
*.user
*.suo
.vs/
.idea/
*.userprefs

# === Bases de données de développement (jamais en dépôt) ===
*.db
*.db-wal
*.db-shm
*.sqlite

# === Journaux ===
logs/
*.log

# === Secrets et configuration locale (ne jamais versionner) ===
appsettings.*.local.json
secrets.json
*.pfx
*.key

# === Divers ===
apercu-*.png
